# Example only: do not enable before explicit DNS/TLS/cutover approval.
# Replace certificate paths with certificates issued for this domain.
server {
    listen 443 ssl;
    server_name gritwms.space;
    ssl_certificate /etc/letsencrypt/live/gritwms.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gritwms.space/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 26m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Replace client-supplied XFF; do not append an untrusted leftmost IP.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
