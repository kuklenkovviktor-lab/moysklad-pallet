# Generate actual values with python3 deploy/init_env.py. Never use these placeholders.
POSTGRES_PASSWORD=
SECRET_KEY=
WMS_BADGE_SECRET=
WMS_TERMINAL_SECRET=
MANAGER_WEB_PASSWORD=
GRIT_DATA_ROOT=/opt/grit-data
GRIT_PORT=8000
BACKUP_INTERVAL_SECONDS=86400
# Offsite backup is opt-in. S3 credentials/alert URLs belong in .env.backup (0600).
BACKUP_S3_ENABLED=0
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ru-central1
BACKUP_S3_PREFIX=grit-wms/hostkey-test
BACKUP_S3_SSE=aws:kms
BACKUP_S3_KMS_KEY_ID=
BACKUP_ALERT_REQUIRED=0
